  "pin_surfaces": [
    {
      "repository": "control-plane-kit-interpreters",
      "path": "pyproject.toml",
      "coordinate_repositories": [
        "control-plane-kit",
        "control-plane-kit-secrets"
      ]
    },
    {
      "repository": "control-plane-kit-servers",
      "path": "pyproject.toml",
      "coordinate_repositories": [
        "control-plane-kit",
        "control-plane-kit-interpreters"
      ]
    },
    {
      "repository": "control-plane-kit-servers",
      "path": "products/cpk_local_gateway/Dockerfile",
      "coordinate_repositories": [
        "control-plane-kit"
      ]
    },
    {
      "repository": "control-plane-kit-servers",
      "path": "products/cpk_server/Dockerfile",
      "coordinate_repositories": [
        "control-plane-kit",
        "control-plane-kit-interpreters"
      ]
    },
    {
      "repository": "control-plane-kit-servers",
      "path": "products/secrets_server/Dockerfile",
      "coordinate_repositories": [
        "control-plane-kit-secrets"
      ]
    }
  ],
  "protocols": [
    {
      "name": "runtime-effect",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-operations/src/control_plane_kit_operations/coordinator.py",
      "protocol_class": "RuntimeEffectInterpreter",
      "methods": ["execute"],
      "implementation_repository": "control-plane-kit-interpreters",
      "implementation_path": "src/control_plane_kit_interpreters/docker/runtime.py",
      "implementation_class": "DockerRuntimeInterpreter"
    },
    {
      "name": "runtime-authority",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-operations/src/control_plane_kit_operations/coordinator.py",
      "protocol_class": "RuntimeAuthorityAwareInterpreter",
      "methods": ["execute_with_authority"],
      "implementation_repository": "control-plane-kit-interpreters",
      "implementation_path": "src/control_plane_kit_interpreters/docker/runtime.py",
      "implementation_class": "DockerRuntimeInterpreter"
    },
    {
      "name": "named-public-ingress",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-operations/src/control_plane_kit_operations/ingress_realization.py",
      "protocol_class": "IngressProviderInterpreter",
      "methods": ["create", "teardown"],
      "implementation_repository": "control-plane-kit-interpreters",
      "implementation_path": "src/control_plane_kit_interpreters/cloudflare/client.py",
      "implementation_class": "CloudflareNamedIngressInterpreter"
    },
    {
      "name": "gateway-probe-dispatch",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-operations/src/control_plane_kit_operations/gateway_probes.py",
      "protocol_class": "GatewayProbeDispatcher",
      "methods": ["dispatch"],
      "implementation_repository": "control-plane-kit-servers",
      "implementation_path": "products/cpk_server/src/control_plane_kit_servers_cpk_server/server.py",
      "implementation_class": "_SignedGatewayProbeDispatcher"
    },
    {
      "name": "secret-resolution",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-core/src/control_plane_kit_core/secrets.py",
      "protocol_class": "AuthorizedSecretResolver",
      "methods": ["resolve"],
      "implementation_repository": "control-plane-kit-interpreters",
      "implementation_path": "src/control_plane_kit_interpreters/secret_provider/resolver.py",
      "implementation_class": "ControlPlaneKitSecretsResolver"
    },
    {
      "name": "secret-custody",
      "protocol_repository": "control-plane-kit",
      "protocol_path": "control-plane-kit-core/src/control_plane_kit_core/secrets.py",
      "protocol_class": "SecretCustodian",
      "methods": ["store", "revoke"],
      "implementation_repository": "control-plane-kit-interpreters",
      "implementation_path": "src/control_plane_kit_interpreters/secret_provider/custody.py",
      "implementation_class": "ControlPlaneKitSecretsCustodian"
    }
  ],
  "acceptance": [
    {
      "name": "cpk-server-http-mcp-source-live",
      "repository": "control-plane-kit-servers",
      "command_path": "scripts/cpk_server_image_smoke.sh",
      "classification": "source-built",
      "authoritative_caller": "cpk-server",
      "provider_mutating": false,
      "published_digest": false,
      "diagnostic_only": false,
      "uses_application_mocks": false,
      "residue_command_path": "scripts/docker_residue_audit.sh"
    }
  ]
}
