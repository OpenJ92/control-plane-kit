{
  "schema": "cpk-server.bootstrap-contract",
  "environment": [
    {
      "name": "CPK_SERVER_MODE",
      "required": true,
      "allowed_values": [
        "execution-capable"
      ]
    },
    {
      "name": "CPK_CONTROL_AUTH_VERIFIER",
      "required": false,
      "allowed_values": [
        "none",
        "static-development"
      ]
    },
    {
      "name": "CPK_CONTROL_AUTH_STATIC_CREDENTIAL",
      "required": false,
      "allowed_values": [
        "runtime-secret-delivered-development-credential"
      ]
    },
    {
      "name": "CPK_CONTROL_AUTH_STATIC_WORKSPACE_GRANTS_JSON",
      "required": false,
      "allowed_values": [
        "trusted-exact-workspace-to-closed-scope-map"
      ]
    },
    {
      "name": "CPK_PORT",
      "required": true,
      "allowed_values": [
        "1..65535"
      ]
    },
    {
      "name": "CPK_RUNTIME_INTERPRETERS",
      "required": true,
      "allowed_values": [
        "none",
        "docker"
      ]
    },
    {
      "name": "CPK_INGRESS_INTERPRETERS",
      "required": false,
      "allowed_values": [
        "none",
        "cloudflare"
      ]
    },
    {
      "name": "CPK_GATEWAY_PROBE_SIGNER",
      "required": false,
      "allowed_values": [
        "none",
        "ed25519"
      ]
    },
    {
      "name": "CPK_GATEWAY_PROBE_SIGNING_KEY_REF",
      "required": false,
      "allowed_values": [
        "runtime-secret-reference"
      ]
    },
    {
      "name": "CPK_GATEWAY_PROBE_ISSUER",
      "required": false,
      "allowed_values": [
        "bounded-issuer-identity"
      ]
    },
    {
      "name": "CPK_GATEWAY_PROBE_KEY_ID",
      "required": false,
      "allowed_values": [
        "bounded-public-key-identity"
      ]
    },
    {
      "name": "CPK_IMAGE_PULL_CREDENTIAL_RESOLVER",
      "required": false,
      "allowed_values": [
        "none",
        "docker-config"
      ]
    },
    {
      "name": "CPK_PRODUCT_SECRET_RESOLVER",
      "required": false,
      "allowed_values": [
        "none",
        "local-development"
      ]
    },
    {
      "name": "CPK_PRODUCT_SECRET_VALUES_JSON",
      "required": false,
      "allowed_values": [
        "runtime-secret-reference-to-value-map"
      ]
    },
    {
      "name": "DOCKER_CONFIG",
      "required": false,
      "allowed_values": [
        "container-local-docker-config-directory"
      ]
    },
    {
      "name": "CPK_DOCKER_AUTH_CONFIG_JSON",
      "required": false,
      "allowed_values": [
        "runtime-secret-delivered-docker-config-json"
      ]
    },
    {
      "name": "CPK_WORKPLACE_DATABASE_URL",
      "required": true,
      "allowed_values": [
        "runtime-provided-postgres-url"
      ]
    },
    {
      "name": "CPK_ACTIVITY_HISTORY_DATABASE_URL",
      "required": true,
      "allowed_values": [
        "runtime-provided-postgres-url"
      ]
    },
    {
      "name": "CPK_OBSERVER_STATE_DATABASE_URL",
      "required": true,
      "allowed_values": [
        "runtime-provided-postgres-url"
      ]
    },
    {
      "name": "CPK_GRAPH_TOPOLOGY_DATABASE_URL",
      "required": true,
      "allowed_values": [
        "runtime-provided-postgres-url"
      ]
    }
  ],
  "runtime_inputs": [
    "authorization credential and static-development verifier credential are runtime-supplied and never echoed",
    "static-development workspace grants are explicit exact-workspace authority and never inferred from request payloads",
    "runtime interpreter authority is selected explicitly and never inferred",
    "ingress interpreter authority is selected explicitly and never inferred",
    "gateway probe signing authority is selected explicitly and resolves only its secret reference at dispatch",
    "store endpoints are runtime-supplied and never echoed by readiness",
    "image pull credential authority is selected explicitly and resolved only at runtime interpreter dispatch",
    "product secret authority is selected explicitly and resolved only at runtime interpreter dispatch"
  ]
}
